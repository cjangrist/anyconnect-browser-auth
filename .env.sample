COMPOSE_PROJECT_NAME=vpn-sidecar
VPN_IMAGE=ghcr.io/cjangrist/anyconnect-browser-auth:latest
VPN_PULL_POLICY=always
VPN_AUTO_UPDATE_ENABLED=true
# Rootless Docker: use the socket path from docker context inspect (without unix://).
VPN_DOCKER_SOCKET=/var/run/docker.sock
VPN_SERVER=https://vpn.example.edu
VPN_USERNAME=user@example.edu
VPN_PASSWORD=replace-me
VPN_TOTP_SECRET=BASE32_TOTP_SECRET
VPN_PROXY_HOST_IP=127.0.0.1
VPN_KEEPALIVE_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9,208.67.222.222,94.140.14.14
VPN_KEEPALIVE_INTERVAL_SECONDS=1
VPN_KEEPALIVE_STALE_MILLISECONDS=15000
VPN_LIVENESS_INTERVAL_MILLISECONDS=1000
VPN_LEAK_CHECK_INTERVAL_MILLISECONDS=300000
VPN_BROWSER_PROFILE_DIRECTORY=/tmp/vpn-browser-profile
VPN_BROWSER_TIMEOUT_MILLISECONDS=180000
VPN_LIVENESS_STATE_FILE=/run/vpn-sidecar/liveness
VPN_LIVENESS_STATE_STALE_MILLISECONDS=30000
VPN_ORIGINAL_PUBLIC_IP_FILE=/run/vpn-sidecar/original-public-ip
VPN_PROXY_EGRESS_CHECK_INTERVAL_MILLISECONDS=300000
VPN_PROXY_FAILURE_THRESHOLD=3
VPN_PROXY_PROBE_TIMEOUT_MILLISECONDS=5000
VPN_PROXY_START_TIMEOUT_MILLISECONDS=15000
VPN_PROXY_SUPERVISE_INTERVAL_MILLISECONDS=15000
VPN_PUBLIC_IP_ENDPOINT=
VPN_PUBLIC_IP_FAMILY=4
VPN_TUNNEL_INTERFACE=tun0
VPN_WATCHDOG_FAILURE_THRESHOLD=3
VPN_WATCHDOG_STARTUP_GRACE_MILLISECONDS=210000
VPN_HEALTHCHECK_INTERVAL=60s
VPN_HEALTHCHECK_TIMEOUT=10s
VPN_HEALTHCHECK_RETRIES=8
VPN_HEALTHCHECK_START_PERIOD=90s
